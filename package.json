{
  "name": "farmtohome",
  "version": "1.0.0",
  "private": true,
  "description": "FarmToHome - Direct Farm to Consumer E-Commerce Platform",
  "proxy": "http://localhost:5001",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"node server.js\" \"react-scripts start\"",
    "dev:backend": "nodemon server.js",
    "dev:frontend": "react-scripts start",
    "start": "node server.js",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "test:api": "node scripts/testEndpoints.js",
    "seed:supabase": "node scripts/seedSupabase.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^14.14.0",
    "jsonwebtoken": "^9.0.2",
    "lenis": "^1.3.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "react-router-dom": "^6.28.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}

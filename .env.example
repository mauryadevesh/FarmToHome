# FarmToHome Environment Configuration Template
# Duplicate this file to .env and fill in your values

# Server Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=farmtohome_super_secret_jwt_key_2026_production

# Supabase PostgreSQL Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Optional (Only needed if running frontend separately on custom URL)
# REACT_APP_API_URL=http://localhost:5001/api
